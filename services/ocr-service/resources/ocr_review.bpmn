<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_ocr_review" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ocr_review" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="review" />
    <bpmn:manualTask id="review" name="OCR-Ergebnis pruefen">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="review" targetRef="notify" />
    <bpmn:serviceTask id="notify" name="OCR-Service benachrichtigen">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="taskType" value="connector_call" />
          <camunda:property name="serviceUrl" value="__SELF_BASE_URL__/ocr-results/{ocr_result_id}/reviewed" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="notify" targetRef="Event_1" />
    <bpmn:endEvent id="Event_1">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
