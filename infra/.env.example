# Kopieren nach .env und bei Bedarf anpassen. .env selbst ist gitignored.

# --- Installations-Identität (Konzept 3a, P13-S1) ---
# EIN Wert für die gesamte Installation, an jeden Service weitergereicht
# (siehe infra/docker-compose.yml, jeweils DMS_INSTALLATION_ID/
# DMS_INSTALLATION_DISPLAY_NAME im environment-Block). Ohne Angabe hier
# bleibt es beim Code-Default ("local-dev"/"DMS-Installation (Entwicklung)")
# - für eine echte Installation eine stabile, eindeutige ID setzen (einmal,
# nicht mehr ändern - license-service bindet Lizenzprüfungen optional daran,
# siehe docs/services/license-service.md).
DMS_INSTALLATION_ID=local-dev
DMS_INSTALLATION_DISPLAY_NAME=DMS-Installation (Entwicklung)

# Fleet-Agent-Schlüssel (Konzept 3a, P13-S2): erlaubt dem unabhängig
# betriebenen fleet-management-service, über den eigenen Gateway zwei eng
# begrenzte Aktionen auszulösen (Lizenzinstallation, Konfigurationsimport) -
# nur license-service/config-service lesen diese Variable. Leer lassen, um
# den Fleet-Zugriff für diese Installation vollständig zu deaktivieren
# (Default-Verhalten ohne .env-Override wäre der hier hinterlegte, NUR für
# den gebündelten Dev-/Test-Stack gedachte Wert - für eine echte Installation
# immer überschreiben oder leer setzen).
DMS_FLEET_AGENT_API_KEY=dev-fleet-agent-key

# --- Postgres (Shared DB, Schema pro Service, Konzept 3.1) ---
POSTGRES_USER=dms
POSTGRES_PASSWORD=dms_dev_only
POSTGRES_DB=dms
POSTGRES_PORT=5432

# --- NATS JetStream (Event-Bus, Konzept 3.4) ---
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# --- Keycloak (Auth/OIDC, Konzept 4.4) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_PORT=8080

# --- MinIO (S3-kompatibles Storage-Backend, Konzept 3.6) ---
MINIO_ROOT_USER=dms_minio
MINIO_ROOT_PASSWORD=dms_minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Registry Service (Konzept 3.2a) ---
REGISTRY_SERVICE_PORT=8001

# --- Monitoring Service + Prometheus (Konzept 10.1, P11-S1) ---
# monitoring-service scraped die /metrics-Endpunkte der Fach-Services selbst
# (Pull/Proxy, siehe docs/operations/monitoring.md) - Prometheus scraped
# ausschliesslich monitoring-service.
MONITORING_SERVICE_PORT=8026
PROMETHEUS_PORT=9090

# cAdvisor (loadtest/) - per-container CPU/memory/network metrics, scraped
# by Prometheus alongside monitoring-service, for resource-sizing analysis.
CADVISOR_PORT=8034

# WebDAV-Referenz-Connector (Konzept 3.3, P12-S1) - macht folder-service/
# document-service über WebDAV ansprechbar (Windows-Explorer/macOS-Finder/
# Word), z. B. per `net use`/"Netzlaufwerk verbinden" auf
# http://localhost:8027/webdav/.
WEBDAV_CONNECTOR_PORT=8027

# Migration/Transfer Service (Konzept 7.2, P12-S2) - Sperren/Kopieren/
# Verifizieren/Freigabe/Löschung zwischen zwei direkt gepaarten Installationen
# dieser Software, siehe docs/services/migration-service.md.
MIGRATION_SERVICE_PORT=8028

# Konfigurationsimport/-export (Konzept 7.3, P12-S3) - Objekttypen/Workflows/
# Rollen-Templates/Vier-Augen-Konfiguration/Sensor-Konfiguration als JSON-
# Dokument, siehe docs/services/config-service.md.
CONFIG_SERVICE_PORT=8029

# CMIS-Referenz-Connector (Konzept 3.3, P12-S4) - macht folder-service/
# document-service über eine selbst implementierte CMIS 1.1 Browser Binding
# ansprechbar (kein Python-CMIS-Server verfügbar, siehe ADR 0036), z. B.
# http://localhost:8030/browser/default/root.
CMIS_CONNECTOR_PORT=8030

# Posteingang/Postausgang-Connector (Konzept 2.5/3.3, P15-S3) - technischer
# Empfang/Versand externer Korrespondenz per POP3/SMTP gegen mailpit als
# Selbst-Loopback-Quelle (siehe dortiger docker-compose.yml-Kommentar).
# Zugangsdaten müssen zu infra/mailpit-pop3-auth passen (dev-only).
MAIL_CONNECTOR_PORT=8033
MAIL_CONNECTOR_POP3_USERNAME=mailconnector
MAIL_CONNECTOR_POP3_PASSWORD=mailconnector
# "Eine eigene, eng begrenzte Rolle darf den ungesichteten Zulauf sehen/
# bearbeiten" (Konzept 2.5, wörtlich).
MAIL_CONNECTOR_POSTSTELLE_ROLE=dms-poststelle

# Fleet-/Lizenz-Management-Service (Konzept 3a, P13-S2) - übergeordnete,
# installationsunabhängige Verwaltungsebene für mehrere Installationen
# (Health-/Lizenz-Überblick, Lizenzvergabe, zentrales Provisioning). Kein
# interner Service dieser Installation, siehe docs/services/fleet-management-service.md.
FLEET_MANAGEMENT_SERVICE_PORT=8031

# Team-Arbeitsbereich "Teamspace" (Konzept 2.5, P14-S6) - selbstverwalteter,
# dauerhafter Gruppenbereich (Ordner/Dokumente/Termine/Kontakte), siehe
# docs/services/teamspace-service.md.
TEAMSPACE_SERVICE_PORT=8032

# --- Grafana (Konzept 10.1, P11-S2) ---
# Dashboards + Datasource werden deklarativ aus infra/grafana/ provisioniert
# (kein manuelles Einrichten nötig) - Default-Login nur für diesen Dev-Stack.
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Audit Service (Konzept 3.4/5.3) ---
AUDIT_SERVICE_PORT=8002

# --- Auth Service (Konzept 4.4) ---
AUTH_SERVICE_PORT=8003
AUTH_SERVICE_CLIENT_SECRET=dms-api-dev-secret
# Föderierte Kontaktsuche (2.5/7.4, P15-S4) - eigene, von workflow-services
# Federation-Hub-Teilnahme unabhängige Registrierung (ADR 0054). Bewusst
# opt-in laut Konzept - in diesem Referenz-Stack per Default aktiviert, damit
# der Selbst-Loopback sofort testbar ist (leer lassen/auf false setzen, um
# es abzuschalten).
AUTH_SERVICE_FEDERATION_HUB_BASE_URL=http://federation-hub-service:8000
AUTH_SERVICE_FEDERATED_DIRECTORY_ENABLED=true

# --- Permission Service (Konzept 4.1) ---
PERMISSION_SERVICE_PORT=8004

# --- Storage Service (Konzept 3.6, ADR 0004/0017) ---
STORAGE_SERVICE_PORT=8005
# Ziel-Set als JSON-Liste (seit P5b-S6, siehe docker-compose.yml für ein
# Beispiel mit einem zweiten S3-Ziel) - Default ein einzelnes lokales Ziel
# (steht für NFS/PVC-Mount), keine Redundanz. Nicht hier gesetzt, da der
# Compose-Default bereits das gewünschte lokale Ziel liefert; zum
# Überschreiben: STORAGE_SERVICE_TARGETS='[{"id":"...","type":"local"|"s3",...}]'
# Redundanz (P3-S4/P5b-S6) - standardmäßig aus (ein einzelnes Ziel), siehe
# docs/adr/0004-storage-redundancy-scope.md / docs/adr/0017-storage-device-identity-guard.md
STORAGE_SERVICE_WRITE_STRATEGY=primary_async
STORAGE_SERVICE_QUORUM_COUNT=1
# Object-Lock/WORM-Governance-Bypass bei Zwangslöschung (5.2a, seit P7-S1,
# ADR 0030) - Rolle aus dem vom Gateway injizierten X-DMS-Roles-Header, die
# eine gesperrte Kopie trotz aktivem retention_until löschen darf. Muss mit
# DOCUMENT_SERVICE_GOVERNANCE_BYPASS_ROLE übereinstimmen.
STORAGE_SERVICE_GOVERNANCE_BYPASS_ROLE=dms-admin

# --- Document Service (Konzept 2.1/2.1a/4.2) ---
DOCUMENT_SERVICE_PORT=8006
# Aufbewahrung/Legal Hold/Zwangslöschung (5.2/5.2a, seit P7-S1) - Poll-
# Intervall für fällige Fristen/Erinnerungen/Papierkorb-Bereinigung sowie die
# Governance-Bypass-Rolle (siehe STORAGE_SERVICE_GOVERNANCE_BYPASS_ROLE oben).
DOCUMENT_SERVICE_RETENTION_POLL_INTERVAL_SECONDS=3600
DOCUMENT_SERVICE_GOVERNANCE_BYPASS_ROLE=dms-admin

# --- Object-Type Service (Konzept 2.2/4.5) ---
OBJECT_TYPE_SERVICE_PORT=8007

# --- Folder Service (Konzept 2.1) ---
FOLDER_SERVICE_PORT=8008
# Aufbewahrung/Legal Hold/Zwangslöschung für Ordner (5.2/5.2a, seit P7-S1b) -
# gleiches Poll-Intervall-Muster wie DOCUMENT_SERVICE_RETENTION_POLL_INTERVAL_SECONDS
# oben, eigenständig konfigurierbar (Ordner können andere Vorgaben brauchen).
FOLDER_SERVICE_RETENTION_POLL_INTERVAL_SECONDS=3600

# --- Virus-Scan Service (Konzept 10.3) ---
VIRUS_SCAN_SERVICE_PORT=8010
# "eicar" (Standard, erkennt nur die EICAR-Testsignatur, siehe
# docs/services/virus-scan-service.md) oder "clamd" (echte Engine, braucht
# einen separat betriebenen clamd-Daemon - hier nicht mitgeliefert)
VIRUS_SCAN_ENGINE=eicar
# Quarantäne-Bereich (2.5, P15-S2): einsehen/freigeben/endgültig löschen
# eines Quarantäne-Falls ist dieser Rolle vorbehalten.
VIRUS_SCAN_QUARANTINE_ADMIN_ROLE=dms-admin

# --- Rendering/Preview Service (Konzept 3.7/2.4) ---
RENDERING_SERVICE_PORT=8011

# --- OCR Service (Konzept 3.9, ADR 0016: Konfigurierbarkeit inkl. Compose-Profil-Opt-out) ---
OCR_SERVICE_PORT=8012
# "ocr" in COMPOSE_PROFILES (unten) aktiviert den Service - Standard: an (wie
# vor P5b-S5). Zum vollständigen Opt-out (ocrEnabled=false, Service wird gar
# nicht deployt): "ocr" aus COMPOSE_PROFILES entfernen. Maximale Wortobergrenze
# und Verarbeitungs-Batch-Size sind dagegen laufzeitveränderlich über
# GET/PUT /config des ocr-service (Admin-UI "OCR-Einstellungen"), kein
# Compose-/Env-Var-Neustart nötig.
COMPOSE_PROFILES=ocr

# --- Search Service (Konzept 3.7, ADR 0012: Postgres FTS statt dediziertem Suchindex) ---
SEARCH_SERVICE_PORT=8013

# --- Workflow Service (Konzept 7.1, ADR 0018/0019: SpiffWorkflow + voller State-Blob) ---
WORKFLOW_SERVICE_PORT=8014
# SLA-Zeitüberwachung (P6-S2, ADR 0020) - Poll-Intervall der Boundary-Timer-Prüfung.
WORKFLOW_SLA_POLL_INTERVAL_SECONDS=30

# --- Notification Service (Konzept 7.1, P6-S2, ADR 0020) ---
NOTIFICATION_SERVICE_PORT=8015
# Dev-SMTP-Testserver (kein echter Versand) - Web-UI unter MAILPIT_UI_PORT.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# POP3-Selbst-Loopback für mail-connector (2.5/3.3, P15-S3, seit mailpit v1.15).
MAILPIT_POP3_PORT=1110

# --- Case Service (Konzept 2.3, P6-S3: Umlaufmappen) ---
CASE_SERVICE_PORT=8016

# --- Federation Hub Service (Konzept 7.4, P6-S9) ---
# Bewusst kein interner Service einer Installation (siehe
# docs/services/federation-hub-service.md) - hier nur der lokalen
# Entwicklung/dem Selbst-Loopback-Smoke-Test halber mitgeliefert.
FEDERATION_HUB_SERVICE_PORT=8018
# workflow-service meldet sich standardmäßig am mitgelieferten lokalen Hub an
# (siehe docker-compose.yml) - leer lassen, um Federation für diese
# Installation vollständig zu deaktivieren (opt-in, Konzept 7.4).
WORKFLOW_SERVICE_FEDERATION_HUB_BASE_URL=http://federation-hub-service:8000
# Der beim Hub gemeldete display_name kommt seit P13-S1 aus der geteilten
# DMS_INSTALLATION_DISPLAY_NAME oben (3a) - kein eigener Wert mehr hier.
# JSON-Zuordnung `targetProcessType` (aus einem föderierten BPMN-Schritt) ->
# lokaler process_definition-Name, siehe docs/services/workflow-service.md
# "Federation". Leer, bis eine konkrete Zuordnung gebraucht wird.
WORKFLOW_SERVICE_FEDERATION_PROCESS_TYPE_MAP={}

# --- API-Gateway/BFF (Konzept 3.5) ---
GATEWAY_SERVICE_PORT=8009
GATEWAY_SERVICE_RATE_LIMIT_MAX_REQUESTS=600
GATEWAY_SERVICE_RATE_LIMIT_WINDOW_SECONDS=60
# CORS-Freigabe für Browser-Frontends - bei geänderten <APP>_PORT-Werten anpassen.
GATEWAY_SERVICE_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3004","http://localhost:3005","http://localhost:3006"]

# --- User-UI (Konzept 8) ---
USER_UI_PORT=3000
# Vom Browser aus erreichbare Gateway-Adresse - wird zur Build-Zeit fest
# eingebrannt (statischer Export, kein Server zur Laufzeit).
USER_UI_GATEWAY_BASE_URL=http://localhost:8009

# --- Admin-UI (Konzept 8) ---
ADMIN_UI_PORT=3001
ADMIN_UI_GATEWAY_BASE_URL=http://localhost:8009

# --- Process Designer (Konzept 7.1/8, P6-S8) ---
PROCESS_DESIGNER_PORT=3002
PROCESS_DESIGNER_GATEWAY_BASE_URL=http://localhost:8009

# --- Reviewer-UI (Konzept 8, P14-S2) ---
# 3003 ist bereits durch GRAFANA_PORT belegt (10.1) - daher 3005 statt der
# sonst nächstliegenden Portnummer.
REVIEWER_UI_PORT=3005
REVIEWER_UI_GATEWAY_BASE_URL=http://localhost:8009

# --- Migrations-Konsole (Konzept 7.2/8, P14-S2) ---
MIGRATION_CONSOLE_PORT=3004
MIGRATION_CONSOLE_GATEWAY_BASE_URL=http://localhost:8009

# --- Office-Add-in (Konzept 3.3a, P14-S8) ---
# ACHTUNG: Office lädt Add-in-Webinhalte nur über HTTPS (außer wenigen
# dokumentierten lokalen Ausnahmen) - dieser Port ist per Default reines HTTP
# wie jeder andere Dienst dieses Stacks, siehe apps/office-addin/README.md
# "Lokales Sideload-Testen" für die nötige TLS-Ergänzung vor einem echten
# Word-Sideload-Test.
OFFICE_ADDIN_PORT=3006
OFFICE_ADDIN_GATEWAY_BASE_URL=http://localhost:8009
# Name des Wurzelordners, der als zentrale Vorlagenbibliothek dient (3.3a) -
# ein Admin legt ihn mit diesem Namen unter der Dokument-Root an.
OFFICE_ADDIN_TEMPLATE_LIBRARY_FOLDER_NAME=Vorlagen
