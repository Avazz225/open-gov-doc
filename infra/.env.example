# Kopieren nach .env und bei Bedarf anpassen. .env selbst ist gitignored.

# --- Postgres (Shared DB, Schema pro Service, Konzept 3.1) ---
POSTGRES_USER=dms
POSTGRES_PASSWORD=dms_dev_only
POSTGRES_DB=dms
POSTGRES_PORT=5432

# --- NATS JetStream (Event-Bus, Konzept 3.4) ---
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# --- Keycloak (Auth/OIDC, Konzept 4.4) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
KEYCLOAK_PORT=8080

# --- MinIO (S3-kompatibles Storage-Backend, Konzept 3.6) ---
MINIO_ROOT_USER=dms_minio
MINIO_ROOT_PASSWORD=dms_minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Registry Service (Konzept 3.2a) ---
REGISTRY_SERVICE_PORT=8001

# --- Audit Service (Konzept 3.4/5.3) ---
AUDIT_SERVICE_PORT=8002

# --- Auth Service (Konzept 4.4) ---
AUTH_SERVICE_PORT=8003
AUTH_SERVICE_CLIENT_SECRET=dms-api-dev-secret

# --- Permission Service (Konzept 4.1) ---
PERMISSION_SERVICE_PORT=8004

# --- Storage Service (Konzept 3.6) ---
STORAGE_SERVICE_PORT=8005
# "local" (Default, steht für NFS/PVC-Mount) oder "s3" (MinIO)
STORAGE_SERVICE_BACKEND=local
# Redundanz (P3-S4) - standardmäßig aus, siehe docs/adr/0004-storage-redundancy-scope.md
STORAGE_SERVICE_REDUNDANCY_ENABLED=false
STORAGE_SERVICE_SECONDARY_BACKEND=none
STORAGE_SERVICE_WRITE_STRATEGY=primary_async
STORAGE_SERVICE_QUORUM_COUNT=2

# --- Document Service (Konzept 2.1/2.1a/4.2) ---
DOCUMENT_SERVICE_PORT=8006

# --- Object-Type Service (Konzept 2.2/4.5) ---
OBJECT_TYPE_SERVICE_PORT=8007

# --- Folder Service (Konzept 2.1) ---
FOLDER_SERVICE_PORT=8008

# --- API-Gateway/BFF (Konzept 3.5) ---
GATEWAY_SERVICE_PORT=8009
GATEWAY_SERVICE_RATE_LIMIT_MAX_REQUESTS=120
GATEWAY_SERVICE_RATE_LIMIT_WINDOW_SECONDS=60
